{
  "openapi": "3.0.0",
  "info": {
    "title": "FlowChat",
    "version": "1.0.0",
    "description": ""
  },
  "servers": [
    {
      "url": "http://localhost:5001/api"
    }
  ],
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "SignUp",
        "tags": [
          "Authentication"
        ],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "color"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/signin": {
      "post": {
        "summary": "SignIn",
        "description": "Log in với username và password. Trả về access token trong res và refresh token trong cookie.",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "User successfully signed in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "User Hai User đã logged in!"
                    },
                    "accessToken": {
                      "type": "string",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    }
                  },
                  "required": [
                    "message",
                    "accessToken"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "color"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        }
      }
    },
    "/auth/google": {
      "post": {
        "summary": "Đăng nhập hoặc đăng ký bằng Google",
        "description": "Xác minh Google ID token, liên kết tài khoản theo email đã xác minh hoặc tạo tài khoản mới.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": {
                    "type": "string"
                  }
                },
                "required": [
                  "idToken"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công và trả về access token"
          },
          "401": {
            "description": "Google ID token không hợp lệ"
          },
          "503": {
            "description": "Máy chủ chưa cấu hình Google Client ID"
          }
        }
      }
    },
    "/auth/signout": {
      "post": {
        "summary": "SignOut",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "RefreshToken",
        "tags": [
          "Authentication"
        ],
        "responses": {}
      }
    },
    "/users/me": {
      "get": {
        "summary": "AuthMe",
        "tags": [
          "Authentication"
        ],
        "responses": {}
      }
    },
    "/friends/requests": {
      "post": {
        "summary": "SendFriendRequest",
        "tags": [
          "Friends"
        ],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "GetFriendRequests",
        "tags": [
          "Friends"
        ],
        "responses": {}
      }
    },
    "/friends/requests/68faed19defb37e90657d7d6/accept": {
      "post": {
        "summary": "AcceptFriendRequest",
        "tags": [
          "Friends"
        ],
        "responses": {}
      }
    },
    "/friends/requests/68fb124874f8418a6bc83ed1/decline": {
      "post": {
        "summary": "DeclineFriendRequest",
        "tags": [
          "Friends"
        ],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/friends/": {
      "get": {
        "summary": "GetAllFriends",
        "tags": [
          "Friends"
        ],
        "responses": {}
      }
    },
    "/messages/direct": {
      "post": {
        "summary": "SendDirectMessage",
        "tags": [
          "Messages"
        ],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recipientId": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "conversationId": {
                    "type": "string"
                  },
                  "replyToMessageId": {
                    "type": "string"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "recipientId",
                  "file"
                ],
                "properties": {
                  "recipientId": {
                    "type": "string"
                  },
                  "conversationId": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string",
                    "description": "Optional attachment caption"
                  },
                  "replyToMessageId": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/conversations/": {
      "post": {
        "summary": "CreateConversation",
        "tags": [
          "Conversations"
        ],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "memberIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "GetConversations",
        "tags": [
          "Conversations"
        ],
        "responses": {}
      }
    },
    "/conversations/68fb2e6a19c501587577291c/messages": {
      "get": {
        "summary": "GetMessage",
        "tags": [
          "Conversations"
        ],
        "responses": {}
      }
    },
    "/messages/group": {
      "post": {
        "summary": "SendGroupMessage",
        "tags": [
          "Messages"
        ],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "conversationId": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "replyToMessageId": {
                    "type": "string"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "conversationId",
                  "file"
                ],
                "properties": {
                  "conversationId": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string",
                    "description": "Optional attachment caption"
                  },
                  "replyToMessageId": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
